# Использование официального образа Go на базе Alpine Linux 
# (он легкий и содержит все утилиты для компиляции)
FROM golang:1.26-alpine AS builder

# Установка рабочей директории внутри контейнера, где будет происходить сборка
WORKDIR /src

# Копирование файлов конфигурации модулей и исходного кода в рабочую директорию
COPY go.mod main.go ./

# Сборка бинарного файла:
# CGO_ENABLED=0 отключает зависимости от C-библиотек, делая бинарник статическим
# -o /out/gateway указывает путь и имя выходного файла
RUN CGO_ENABLED=0 go build -o /out/gateway .


# Использование минималистичного и безопасного образа distroless от Google.
# Он не содержит пакетного менеджера, командной оболочки и лишних утилит.
# Тег 'nonroot' запускает приложение от имени пользователя без прав root.
FROM gcr.io/distroless/static-debian12:nonroot

# Копирование бинарника из предыдущего этапа в корень финального образа
COPY --from=builder /out/gateway /gateway

# Документирование сетевого порта 8080
EXPOSE 8080

# Указывание команды, которая будет выполнена при запуске контейнера
ENTRYPOINT ["/gateway"]