# Использование официального легковесного образа Python на базе Debian (slim)
# Это отличный баланс между размером образа и совместимостью с библиотеками
FROM python:3.12-slim

# Установка рабочей директории, в которой будут выполняться все последующие команды
WORKDIR /app

# Настройка переменных окружения для Python:
# 1 - запрещает Python записывать файлы .pyc на диск 
# 2 - отключает буферизацию потоков вывода 
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONBUFFERED=1

# Сначала копируется только файл со списком зависимостей.
# слой пересоберется только при изменении требований    
COPY requirements.txt .

# Установка библиотек:
# --no-cache-dir отключает сохранение скачанных .whl файлов внутри контейнера
RUN pip install --no-cache-dir -r requirements.txt

# Копирование основного файла приложения в рабочую директорию
COPY main.py .

# Создаем системного пользователя с домашней директорией для безопасности
RUN useradd -m aveslay

# Переключtybt на созданного пользователя, чтобы приложение не работало с правами root
USER aveslay

# Документирование порта, которого будет слушать приложение 
EXPOSE 8001

# Команда для запуска ASGI-сервера Uvicorn при старте контейнера.
# Слушаем все интерфейсы (0.0.0.0) на порту 8001
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8001"]
